# Epic Compliance Tool — environment template
#
# Copy to .env and fill in the values. .env is gitignored; NEVER commit it.
#   cp .env.example .env
#
# Every key maps to a field on AppConfig in epic_compliance/config.py.

# ---------------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------------
# mock — offline fixtures, no credentials needed
# live — real HTTP against the endpoints below
RUN_MODE=mock

# ---------------------------------------------------------------------------
# Epic FHIR endpoints (public sandbox defaults — no account needed to reach these)
# ---------------------------------------------------------------------------
FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
SMART_LAUNCH_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/authorize
SMART_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# ---------------------------------------------------------------------------
# OAuth client — from your NON-PRODUCTION app at https://fhir.epic.com
# ---------------------------------------------------------------------------
# How to get OAUTH_CLIENT_ID:
#   1. Sign in at https://fhir.epic.com (free developer account).
#   2. Build Apps -> create an app. Audience "Patients" for a patient-facing app.
#   3. Add the FHIR R4 resources you need (Patient.Read, Observation.Read, ...).
#   4. Redirect URI: paste OAUTH_REDIRECT_URI below EXACTLY — Epic matches it
#      character-for-character.
#   5. Mobile / no client secret? Mark it a public client using PKCE.
#   6. Save, then copy the *Non-Production* Client ID (NOT the production one).
# Newly registered apps take a while to reach the sandbox; a valid-looking id can
# still be rejected for the first few hours.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/callback

# Interactive launch tests (pytest -m launch --launch-interactive).
# Leave blank: tests/conftest.py loads this .env and falls back to OAUTH_CLIENT_ID
# above. Set it only to point the tests at a DIFFERENT registered app.
EPIC_SANDBOX_CLIENT_ID=
EPIC_SANDBOX_REDIRECT_URI=

# ---------------------------------------------------------------------------
# LLM-assisted manual checks (optional)
# ---------------------------------------------------------------------------
# Without a key, security rules return "needs_human" instead of a verdict.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# ONC (g)(10) Test Kit — see CLAUDE.md; runs under Podman, not Docker
# ---------------------------------------------------------------------------
ONC_TEST_KIT_URL=http://localhost:8080
